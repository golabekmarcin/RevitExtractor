<!-- Export button, model window (specs/SPEC-export-button.md). Every label is a DynamicResource
     reference; the English/Polish text lives in rx_export_text.py (UI_TEXT). Rx* keys come from
     lib/rx_theme.xaml, merged by rx_export_ui.py after the window loads. Greyed rows (newer or
     unreadable version) are disabled items whose tooltip still shows. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource models_title}" Width="1080" Height="760"
        MinWidth="860" MinHeight="600" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="CheckTemplate">
            <CheckBox IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="6,2" ToolTip="{DynamicResource check_tooltip}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource models_header}" Style="{DynamicResource RxWindowTitle}"/>
            <TextBlock x:Name="caps_text" Style="{DynamicResource RxMuted}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{DynamicResource RxCard}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource models_roots}" Style="{DynamicResource RxSectionTitle}"/>
                    <ListBox Grid.Row="1" x:Name="roots_lb" Height="66" SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <Button x:Name="add_root_btn" Content="{DynamicResource models_add_root}" Margin="0,0,0,6"/>
                        <Button x:Name="remove_root_btn" Content="{DynamicResource models_remove_root}"
                                ToolTip="{DynamicResource models_remove_root_tip}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource models_output}" Style="{DynamicResource RxSectionTitle}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="output_btn" Content="{DynamicResource models_change_output}" Margin="8,0,0,0"/>
                        <TextBlock x:Name="output_text" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource models_output_hint}" Style="{DynamicResource RxMuted}" FontSize="11"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,8">
            <ContentControl x:Name="search_host" Focusable="False" Margin="0,0,0,8"/>
            <DockPanel>
                <Button x:Name="all_btn" Content="{DynamicResource check_visible}" Margin="0,0,8,0"/>
                <Button x:Name="none_btn" Content="{DynamicResource uncheck_visible}" Margin="0,0,12,0"/>
                <TextBlock Text="{DynamicResource selection_hint}" Style="{DynamicResource RxMuted}" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </StackPanel>
        <ListView Grid.Row="3" x:Name="models_lv" SelectionMode="Extended"
                  ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                    <Setter Property="ToolTip" Value="{Binding Tip}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View><GridView>
                <GridViewColumn Header="✓" Width="44" CellTemplate="{StaticResource CheckTemplate}"/>
                <GridViewColumn Header="{DynamicResource models_col_name}" Width="240" DisplayMemberBinding="{Binding Name}"/>
                <!-- Index 2 and 3: rx_export_ui.py puts the column filters on these headers. -->
                <GridViewColumn Header="{DynamicResource models_col_folder}" Width="280" DisplayMemberBinding="{Binding Folder}"/>
                <GridViewColumn Header="{DynamicResource models_col_version}" Width="110" DisplayMemberBinding="{Binding Version}"/>
                <GridViewColumn Header="{DynamicResource models_col_note}" Width="300" DisplayMemberBinding="{Binding Note}"/>
            </GridView></ListView.View>
        </ListView>
        <TextBlock Grid.Row="4" x:Name="count_text" Margin="0,6,0,0" Style="{DynamicResource RxMuted}" TextWrapping="Wrap"/>
        <Border Grid.Row="5" Style="{DynamicResource RxCard}" Padding="12,6" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock Text="{DynamicResource models_scope}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <RadioButton x:Name="default_scope_rb" GroupName="scope" Content="{DynamicResource models_scope_default}"
                             ToolTip="{DynamicResource models_scope_default_tip}" VerticalAlignment="Center" Margin="0,2,22,2"/>
                <RadioButton x:Name="shared_scope_rb" GroupName="scope" Content="{DynamicResource models_scope_shared}"
                             ToolTip="{DynamicResource models_scope_shared_tip}" VerticalAlignment="Center" Margin="0,2,8,2"/>
                <Button DockPanel.Dock="Right" x:Name="shared_choose_btn" Content="{DynamicResource models_shared_choose}" Margin="8,0,0,0"/>
                <TextBlock x:Name="shared_path_text" Style="{DynamicResource RxMuted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="6" x:Name="error_text" Style="{DynamicResource RxError}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <Grid Grid.Row="7" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="rescan_btn" Content="{DynamicResource models_rescan}" ToolTip="{DynamicResource models_rescan_tip}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                <TextBlock x:Name="summary_text" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="status_text" Margin="0,2,0,0" Style="{DynamicResource RxMuted}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="close_btn" IsCancel="True" Content="{DynamicResource close}" Margin="0,0,8,0"/>
                <Button x:Name="views_btn" Content="{DynamicResource models_views}" ToolTip="{DynamicResource models_views_tip}"
                        ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0"/>
                <Button x:Name="export_btn" IsDefault="True" Content="{DynamicResource models_export}"
                        ToolTip="{DynamicResource models_export_tip}" ToolTipService.ShowOnDisabled="True"
                        Style="{DynamicResource RxPrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
