<!-- Export button, naming profile dialog (specs/SPEC-named-copies.md). Every label is a
     DynamicResource reference; the English/Polish text lives in rx_export_text.py (UI_TEXT).
     Rx* keys come from lib/rx_theme.xaml, merged by rx_export_naming_ui.py after the window loads.
     The two tabs are headers only: one set of lists below serves both, and the code swaps the
     data when the tab changes. The left list is flat (no headers). Its items carry Label and
     Cls (builtin, custom or system): built-in is bold, custom regular, system muted. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource naming_title}" Width="720" Height="620"
        MinWidth="620" MinHeight="520" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="PropertyTemplate">
            <TextBlock x:Name="label" Text="{Binding Label}" Margin="2,1" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource RxText}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Cls}" Value="builtin">
                    <Setter TargetName="label" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cls}" Value="system">
                    <Setter TargetName="label" Property="Foreground" Value="{DynamicResource RxMutedText}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="MoveButton" TargetType="Button">
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 profile name -->
            <RowDefinition Height="Auto"/>   <!-- 1 tabs and search -->
            <RowDefinition Height="*"/>      <!-- 2 the two lists -->
            <RowDefinition Height="Auto"/>   <!-- 3 separator -->
            <RowDefinition Height="Auto"/>   <!-- 4 preview -->
            <RowDefinition Height="Auto"/>   <!-- 5 split option and error -->
            <RowDefinition Height="Auto"/>   <!-- 6 buttons -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource naming_name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" x:Name="profile_name_tb" Padding="4,3" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{DynamicResource naming_name}"/>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <ContentControl DockPanel.Dock="Right" x:Name="search_host" Width="240" Focusable="False"/>
            <TabControl x:Name="kind_tabs" BorderThickness="0" Padding="0" Background="Transparent">
                <TabItem x:Name="views_tab" Header="{DynamicResource naming_tab_views}"/>
                <TabItem x:Name="sheets_tab" Header="{DynamicResource naming_tab_sheets}"/>
            </TabControl>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource naming_available}" Style="{DynamicResource RxSectionTitle}" Margin="0,0,0,4"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource naming_chosen}" Style="{DynamicResource RxSectionTitle}" Margin="0,0,0,4"/>
            <ListBox Grid.Row="1" x:Name="available_lb" SelectionMode="Extended" ItemTemplate="{StaticResource PropertyTemplate}"
                     AutomationProperties.Name="{DynamicResource naming_available}"/>
            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button x:Name="add_btn" Content="{DynamicResource naming_add}" Style="{StaticResource MoveButton}"/>
                <Button x:Name="remove_btn" Content="{DynamicResource naming_remove}" Style="{StaticResource MoveButton}"/>
            </StackPanel>
            <ListBox Grid.Row="1" Grid.Column="2" x:Name="chosen_lb" SelectionMode="Extended" ItemTemplate="{StaticResource PropertyTemplate}"
                     AutomationProperties.Name="{DynamicResource naming_chosen}"/>
            <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button x:Name="up_btn" Content="{DynamicResource naming_up}" Style="{StaticResource MoveButton}"/>
                <Button x:Name="down_btn" Content="{DynamicResource naming_down}" Style="{StaticResource MoveButton}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource naming_separator}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox Grid.Column="1" x:Name="separator_cb" MinWidth="120" AutomationProperties.Name="{DynamicResource naming_separator}"/>
        </Grid>

        <Border Grid.Row="4" Style="{DynamicResource RxCard}" Padding="12,8" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource naming_preview}" Style="{DynamicResource RxMuted}" FontSize="11"/>
                <TextBlock x:Name="preview_text" Foreground="{DynamicResource RxText}" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.Name="{DynamicResource naming_preview}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <CheckBox x:Name="split_cb" Content="{DynamicResource naming_split}" ToolTip="{DynamicResource naming_split_tip}"/>
            <TextBlock x:Name="error_text" Style="{DynamicResource RxError}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="cancel_btn" IsCancel="True" Content="{DynamicResource naming_cancel}" MinWidth="80" Margin="0,0,8,0"/>
            <Button x:Name="save_as_btn" Content="{DynamicResource naming_save_as}" MinWidth="80" Margin="0,0,8,0"/>
            <Button x:Name="save_btn" IsDefault="True" Content="{DynamicResource naming_save}" MinWidth="80"
                    Style="{DynamicResource RxPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
