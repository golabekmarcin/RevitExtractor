<!-- Status window (specs/SPEC-status-window.md). Every label is a DynamicResource reference; the
     English/Polish text lives in rx_status.py (UI_TEXT). Rx* keys come from rx_theme.xaml, merged by
     rx_status_ui.py after the window loads. No text input on purpose: modeless keyboard input inside
     Revit is unreliable. Close (IsCancel, so also Esc) minimises or hides; the window is never closed. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource status_title}" Width="760" Height="420"
        MinWidth="720" MinHeight="300" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource status_header}" Style="{DynamicResource RxWindowTitle}"/>
            <TextBlock x:Name="summary_text" Style="{DynamicResource RxMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ListView Grid.Row="1" x:Name="jobs_lv" SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="menu_show_model" Header="{DynamicResource status_menu_model}"/>
                    <MenuItem x:Name="menu_show_folder" Header="{DynamicResource status_menu_folder}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View><GridView>
                <GridViewColumn Header="{DynamicResource status_col_model}" Width="180">
                    <GridViewColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding Model}" ToolTip="{Binding ModelPath}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{DynamicResource status_col_state}" Width="96" DisplayMemberBinding="{Binding State}"/>
                <GridViewColumn Header="{DynamicResource status_col_progress}" Width="296">
                    <GridViewColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding Progress}" ToolTip="{Binding Progress}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{DynamicResource status_col_started}" Width="70" DisplayMemberBinding="{Binding Started}"/>
                <GridViewColumn Header="{DynamicResource status_col_time}" Width="62" DisplayMemberBinding="{Binding Time}"/>
            </GridView></ListView.View>
        </ListView>
        <TextBlock Grid.Row="2" x:Name="hint_text" Style="{DynamicResource RxMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock Grid.Row="3" x:Name="error_text" Style="{DynamicResource RxError}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="cancel_btn" Content="{DynamicResource status_cancel}"
                    ToolTip="{DynamicResource status_cancel_tip}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0"/>
            <Button Grid.Column="1" x:Name="open_folder_btn" Content="{DynamicResource status_open_folder}"
                    ToolTip="{DynamicResource status_open_folder_tip}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="open_analyzer_btn" Content="{DynamicResource status_open_analyzer}"
                    ToolTip="{DynamicResource status_open_analyzer_tip}" ToolTipService.ShowOnDisabled="True"
                    Style="{DynamicResource RxPrimaryButton}"/>
            <Button Grid.Column="4" x:Name="clear_finished_btn" Content="{DynamicResource status_clear_finished}"
                    ToolTip="{DynamicResource status_clear_finished_tip}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0"/>
            <Button Grid.Column="5" x:Name="close_btn" IsCancel="True" Content="{DynamicResource status_close}"
                    ToolTip="{DynamicResource status_close_tip}"/>
        </Grid>
    </Grid>
</Window>
